From 1c5fe37266f622187d710a6d6d97d6b4f4243809 Mon Sep 17 00:00:00 2001
From: Matthew Busel <mattbusel@gmail.com>
Date: Thu, 12 Nov 2026 09:33:47 -0500
Subject: [PATCH] Add OPENSSL_cpuid_setup for aarch64 QNX

QNX Neutrino has no getauxval, so no cpu_aarch64_*.c file defined
OPENSSL_cpuid_setup on aarch64 QNX and any link that pulls in libcrypto
failed with an undefined reference. Read the ARMv8 feature flags that
the QNX startup program records in the system page cpuinfo entries.
---
 crypto/fipsmodule/bcm.c                    |  1 +
 crypto/fipsmodule/cpucap/cpu_aarch64_qnx.c | 73 ++++++++++++++++++++++
 2 files changed, 74 insertions(+)
 create mode 100644 crypto/fipsmodule/cpucap/cpu_aarch64_qnx.c

diff --git a/crypto/fipsmodule/bcm.c b/crypto/fipsmodule/bcm.c
index 00a58c2..469c258 100644
--- a/crypto/fipsmodule/bcm.c
+++ b/crypto/fipsmodule/bcm.c
@@ -73,6 +73,7 @@
 #include "cpucap/cpu_aarch64_linux.c"
 #include "cpucap/cpu_aarch64_netbsd.c"
 #include "cpucap/cpu_aarch64_openbsd.c"
+#include "cpucap/cpu_aarch64_qnx.c"
 #include "cpucap/cpu_aarch64_win.c"
 #include "cpucap/cpu_arm_freebsd.c"
 #include "cpucap/cpu_arm_linux.c"
diff --git a/crypto/fipsmodule/cpucap/cpu_aarch64_qnx.c b/crypto/fipsmodule/cpucap/cpu_aarch64_qnx.c
new file mode 100644
index 0000000..a743f5d
--- /dev/null
+++ b/crypto/fipsmodule/cpucap/cpu_aarch64_qnx.c
@@ -0,0 +1,73 @@
+// Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0 OR ISC
+
+#include "internal.h"
+
+#if defined(OPENSSL_AARCH64) && defined(__QNX__) && \
+    !defined(OPENSSL_STATIC_ARMCAP)
+
+#include <sys/syspage.h>
+#include <aarch64/syspage.h>
+
+#include <openssl/arm_arch.h>
+
+#include "cpu_aarch64.h"
+
+// QNX Neutrino has no getauxval/AT_HWCAP. The startup program probes the
+// ID_AA64* registers at boot and records the result in the |flags| field of
+// each |cpuinfo| entry of the system page, which is mapped read-only into every
+// process. See <aarch64/syspage.h> for the AARCH64_CPU_FLAG_* values.
+void OPENSSL_cpuid_setup(void) {
+  const struct cpuinfo_entry *cpuinfo = SYSPAGE_ENTRY(cpuinfo);
+  unsigned num_cpu = _syspage_ptr->num_cpu;
+  if (num_cpu == 0) {
+    return;
+  }
+
+  // Only report features present on every core, in case the system is
+  // heterogeneous and the thread migrates.
+  uint64_t flags = ~(uint64_t)0;
+  for (unsigned i = 0; i < num_cpu; i++) {
+    flags &= cpuinfo[i].flags;
+  }
+
+  if ((flags & AARCH64_CPU_FLAG_SIMD) == 0) {
+    // Matching OpenSSL, if NEON is missing, don't report other features
+    // either.
+    return;
+  }
+
+  OPENSSL_armcap_P |= ARMV7_NEON;
+
+  if (flags & AARCH64_CPU_FLAG_AES) {
+    OPENSSL_armcap_P |= ARMV8_AES;
+  }
+  if (flags & AARCH64_CPU_FLAG_PMULL) {
+    OPENSSL_armcap_P |= ARMV8_PMULL;
+  }
+  if (flags & AARCH64_CPU_FLAG_SHA1) {
+    OPENSSL_armcap_P |= ARMV8_SHA1;
+  }
+  if (flags & AARCH64_CPU_FLAG_SHA256) {
+    OPENSSL_armcap_P |= ARMV8_SHA256;
+  }
+  if (flags & AARCH64_CPU_FLAG_SHA512) {
+    OPENSSL_armcap_P |= ARMV8_SHA512;
+  }
+  if (flags & AARCH64_CPU_FLAG_SHA3) {
+    OPENSSL_armcap_P |= ARMV8_SHA3;
+  }
+  if (flags & AARCH64_CPU_FLAG_RNDR) {
+    OPENSSL_armcap_P |= ARMV8_RNG;
+  }
+
+  // See the comment in cpu_aarch64_linux.c about OPENSSL_armcap.
+  const char *env = getenv("OPENSSL_armcap");
+  if (env != NULL) {
+    handle_cpu_env(&OPENSSL_armcap_P, env);
+  }
+
+  OPENSSL_cpucap_initialized = 1;
+}
+
+#endif  // OPENSSL_AARCH64 && __QNX__ && !OPENSSL_STATIC_ARMCAP
-- 
2.49.0.windows.1

