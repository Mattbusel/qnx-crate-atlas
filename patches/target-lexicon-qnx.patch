From 3378aa10428e3085269c464c9e5c38bd5ce7151c Mon Sep 17 00:00:00 2001
From: Matthew Charles Busel <mattbusel@gmail.com>
Date: Sat, 7 Nov 2026 18:59:20 -0500
Subject: [PATCH] Add QNX Neutrino (nto) and QNX 8 (qnx) operating systems

Parse the rustc QNX triples: *-nto-qnx700, *-nto-qnx710, *-nto-qnx710_iosock,
the *-nto-qnx800 triples used by the Rust toolchain in QNX SDP 8.0, and the
renamed upstream QNX 8.0 triples x86_64-pc-qnx and aarch64-unknown-qnx.

Adds OperatingSystem::Nto and OperatingSystem::Qnx (SystemV calling
convention, ELF), and Environment::Qnx700, Qnx710, Qnx710Iosock and Qnx800.
The QNX triples that were commented out as TODO in the known-triples
test are enabled, plus the new ones.
---
 src/targets.rs | 39 ++++++++++++++++++++++++++++++++++++---
 src/triple.rs  |  2 ++
 2 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/src/targets.rs b/src/targets.rs
index 5cc5c2d..0bcf62f 100644
--- a/src/targets.rs
+++ b/src/targets.rs
@@ -742,8 +742,13 @@ pub enum OperatingSystem {
     Nebulet,
     Netbsd,
     None_,
+    /// QNX Neutrino, as spelled by the `*-nto-qnx*` triples (QNX 7.0, 7.1 and the QNX SDP 8.0
+    /// toolchain).
+    Nto,
     Openbsd,
     Psp,
+    /// QNX 8.0, as spelled by the `x86_64-pc-qnx` and `aarch64-unknown-qnx` triples.
+    Qnx,
     Redox,
     Solaris,
     SolidAsp3,
@@ -804,9 +809,11 @@ impl OperatingSystem {
             MacOSX(deployment_target) => darwin_version("macosx", deployment_target),
             Nebulet => Cow::Borrowed("nebulet"),
             Netbsd => Cow::Borrowed("netbsd"),
+            Nto => Cow::Borrowed("nto"),
             None_ => Cow::Borrowed("none"),
             Openbsd => Cow::Borrowed("openbsd"),
             Psp => Cow::Borrowed("psp"),
+            Qnx => Cow::Borrowed("qnx"),
             Redox => Cow::Borrowed("redox"),
             Solaris => Cow::Borrowed("solaris"),
             SolidAsp3 => Cow::Borrowed("solid_asp3"),
@@ -886,6 +893,14 @@ pub enum Environment {
     Spe,
     Threads,
     Ohos,
+    /// QNX 7.0
+    Qnx700,
+    /// QNX 7.1 with the io-pkt network stack
+    Qnx710,
+    /// QNX 7.1 with the io-sock network stack
+    Qnx710Iosock,
+    /// QNX 8.0 (the `*-nto-qnx800` triples)
+    Qnx800,
 }
 
 impl Environment {
@@ -929,6 +944,10 @@ impl Environment {
             Spe => Cow::Borrowed("spe"),
             Threads => Cow::Borrowed("threads"),
             Ohos => Cow::Borrowed("ohos"),
+            Qnx700 => Cow::Borrowed("qnx700"),
+            Qnx710 => Cow::Borrowed("qnx710"),
+            Qnx710Iosock => Cow::Borrowed("qnx710_iosock"),
+            Qnx800 => Cow::Borrowed("qnx800"),
         }
     }
 }
@@ -1660,9 +1679,11 @@ impl FromStr for OperatingSystem {
             "linux" => Linux,
             "nebulet" => Nebulet,
             "netbsd" => Netbsd,
+            "nto" => Nto,
             "none" => None_,
             "openbsd" => Openbsd,
             "psp" => Psp,
+            "qnx" => Qnx,
             "redox" => Redox,
             "solaris" => Solaris,
             "solid_asp3" => SolidAsp3,
@@ -1727,6 +1748,10 @@ impl FromStr for Environment {
             "spe" => Spe,
             "threads" => Threads,
             "ohos" => Ohos,
+            "qnx700" => Qnx700,
+            "qnx710" => Qnx710,
+            "qnx710_iosock" => Qnx710Iosock,
+            "qnx800" => Qnx800,
             _ => return Err(()),
         })
     }
@@ -1799,7 +1824,11 @@ mod tests {
             "aarch64-unknown-netbsd",
             "aarch64-unknown-none",
             "aarch64-unknown-none-softfloat",
-            //"aarch64-unknown-nto-qnx710", // TODO
+            "aarch64-unknown-nto-qnx700",
+            "aarch64-unknown-nto-qnx710",
+            "aarch64-unknown-nto-qnx710_iosock",
+            "aarch64-unknown-nto-qnx800",
+            "aarch64-unknown-qnx",
             "aarch64-unknown-openbsd",
             "aarch64-unknown-redox",
             //"aarch64-unknown-teeos", // TODO
@@ -1862,7 +1891,8 @@ mod tests {
             "hexagon-unknown-linux-musl",
             "hexagon-unknown-none-elf",
             "i386-apple-ios",
-            //"i586-pc-nto-qnx700", // TODO
+            "i586-pc-nto-qnx700",
+            "i686-pc-nto-qnx700",
             "i586-pc-windows-msvc",
             "i586-unknown-linux-gnu",
             "i586-unknown-linux-musl",
@@ -1997,7 +2027,10 @@ mod tests {
             "x86_64-fortanix-unknown-sgx",
             "x86_64h-apple-darwin",
             "x86_64-linux-android",
-            //"x86_64-pc-nto-qnx710", // TODO
+            "x86_64-pc-nto-qnx710",
+            "x86_64-pc-nto-qnx710_iosock",
+            "x86_64-pc-nto-qnx800",
+            "x86_64-pc-qnx",
             "x86_64-linux-kernel", // Changed to x86_64-unknown-none-linuxkernel in 1.53.0
             "x86_64-apple-macosx",
             "x86_64-apple-macosx10.7.0",
diff --git a/src/triple.rs b/src/triple.rs
index 6b10f04..3c84bb6 100644
--- a/src/triple.rs
+++ b/src/triple.rs
@@ -141,7 +141,9 @@ impl Triple {
             | OperatingSystem::L4re
             | OperatingSystem::Linux
             | OperatingSystem::Netbsd
+            | OperatingSystem::Nto
             | OperatingSystem::Openbsd
+            | OperatingSystem::Qnx
             | OperatingSystem::Redox
             | OperatingSystem::Solaris => CallingConvention::SystemV,
             OperatingSystem::Windows => CallingConvention::WindowsFastcall,
-- 
2.49.0.windows.1

